## Public site
NEXT_PUBLIC_SITE_URL=https://www.getluckygolf.co.za

## Resend (email)
RESEND_API_KEY=
EMAIL_FROM="Get Lucky Golf Club <forms@getluckygolf.co.za>"
EMAIL_NOTIFY_TO=johannes@getluckygolfclub.com
EMAIL_REPLY_TO=johannes@getluckygolfclub.com

## Sheets via Google Apps Script Web App (no GCP service account needed)
SHEETS_WEBAPP_URL=
SHEETS_SECRET=

## Supabase (Postgres) — durable system-of-record for entries/vouchers/leads.
## Server-side only: the service-role key bypasses RLS and must NEVER be a
## NEXT_PUBLIC_ var or shipped to the browser. Apply supabase/migrations first.
## Leave both blank to keep the site running Sheets-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

## PayFast — set MODE=sandbox while testing, MODE=live for production
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

## Sponsor read API — random 32+ char string, share with sponsor as Bearer token
SPONSOR_API_KEY=

## Indwe headline-sponsor read API — single endpoint at /api/indwe/leads
## Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INDWE_API_KEY=

## Subscriptions Supabase (membership.getluckygolfclub.com) — SEPARATE project.
## Read-only here: /api/indwe/leads folds its `indwe_leads` (the membership
## "switch to Indwe" leads) into the unified feed so Indwe pulls everything from
## one endpoint. Use that project's URL + a service-role key. Leave blank to omit
## membership leads from the API (everything else still works).
SUBSCRIPTIONS_SUPABASE_URL=
SUBSCRIPTIONS_SUPABASE_SERVICE_ROLE_KEY=

## Ops alert recipient — daily PayFast health check emails failures here.
## Optional: code falls back to johannes@getluckygolfclub.com if unset.
OPS_ALERT_EMAIL=johannes@getluckygolfclub.com

# ---------------------------------------------------------------------------
# WhatsApp channel (getluckyjo/twillio)
# ---------------------------------------------------------------------------
# Entries are handed to the WhatsApp service for follow-up. Leave both unset and
# the handoff is skipped silently — a normal state while the channel is not live.
# WHATSAPP_API_SECRET must match ENTRY_WEBHOOK_SECRET in that service.
WHATSAPP_API_URL=https://twillio-delta.vercel.app
WHATSAPP_API_SECRET=

# Internal ops scorecard at /ops. Any long random string; share it with the
# founders only. Unset means the dashboard cannot be opened at all.
OPS_DASHBOARD_KEY=
